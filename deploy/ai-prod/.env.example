# 复制为 .env 后填真实值（不要提交；已在 .gitignore 忽略）
#
# 🔴 三个都是必填：MCP_IMAGE 是 CI 制品；JIEAPI_KEY 是上游网关令牌；
#    MCP_AUTH_TOKEN 是本服务的鉴权口令。

# CI 制品（GHCR）。钉版本，别用 latest：
#   ghcr.io/jushenzhidao/mcps:sha-<短sha>   或   ghcr.io/jushenzhidao/mcps:v1.2.3
MCP_IMAGE=ghcr.io/jushenzhidao/mcps:sha-xxxxxxxx

# 上游网关令牌（会花钱）
JIEAPI_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JIEAPI_BASE_URL=https://jieapi.com

# 本服务对外鉴权口令（客户端需带 Authorization: Bearer <该值>）
# 生成：openssl rand -hex 32
MCP_AUTH_TOKEN=

# DNS rebinding 防护放行的 Host（反代过来的 Host 头）
MCP_ALLOWED_HOSTS=mcp.1task.cn

# 可选调优
MCP_MAX_CONCURRENCY=40
GATEWAY_TIMEOUT=120
IMAGE_MAX_FILE_MB=10
