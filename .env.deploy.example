# 复制为 .env.deploy 后填写真实值（.env.deploy 已被 .gitignore 忽略）

# 网关令牌（必填）
JIEAPI_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JIEAPI_BASE_URL=https://jieapi.com

# 服务端鉴权令牌（必填；客户端调用需带 Authorization: Bearer <该值>）
# 生成：openssl rand -hex 32
MCP_AUTH_TOKEN=

# 反代域名（DNS rebinding 防护放行；localhost/127.0.0.1 自动附加）
MCP_ALLOWED_HOSTS=mcp.1task.cn

# 可选
GATEWAY_TIMEOUT=120
IMAGE_MAX_FILE_MB=10
