# ===== 网关凭据（必填）=====
# 你在 jieapi.com（new-api 实例）上的令牌。禁止提交真实值到版本库。
JIEAPI_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 网关地址。默认主域；国内网络不佳时可用回国入口 https://apicn.jieapi.com
JIEAPI_BASE_URL=https://jieapi.com

# ===== 可选调优 =====
# image 参数为本机文件时的单文件大小上限（MB）
IMAGE_MAX_FILE_MB=10
# 网关请求超时（秒）
GATEWAY_TIMEOUT=120
# GET /v1/models 内存缓存时长（秒）
MODELS_CACHE_TTL=300
# 能力映射表路径（默认 <仓库>/capabilities.yaml）
# CAPABILITIES_FILE=/absolute/path/to/capabilities.yaml
